# ===================================================
# DONASIKU - FIREBASE CONFIGURATION
# ===================================================
# Dapatkan kredensial ini dari Firebase Console:
# 1. Buka https://console.firebase.google.com/
# 2. Buat proyek baru / pilih proyek "DonasiKu"
# 3. Tambahkan Web App & salin konfigurasi di bawah ke .env.local

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=donasiku-web.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=donasiku-web
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=donasiku-web.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# (Opsional) Firebase Admin Service Account Key (format JSON string) untuk Server Side:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
