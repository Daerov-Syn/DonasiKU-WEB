// Firestore Security Rules for DonasiKu Web & Mobile Cross-Platform Access
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Data User
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Program Kampanye & Kategori
    match /programs/{programId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 3. Profil Mitra
    match /mitra_profiles/{document=**} {
      allow read, write: if true;
    }

    // 4. Donasi Barang & Donasi Uang
    match /donation_items/{itemId} {
      allow read, write: if true;
    }

    match /donation_money/{moneyId} {
      allow read, write: if true;
    }

    match /donasiDana/{moneyId} {
      allow read, write: if true;
    }

    match /donatur_dana/{document=**} {
      allow read, write: if true;
    }

    // 5. Sertifikat Donasi
    match /certificates/{certId} {
      allow read, write: if true;
    }

    // 6. Data Notifikasi, Impact Stories, & FAQ
    match /notifikasi/{document=**} {
      allow read, write: if true;
    }

    match /notifications/{document=**} {
      allow read, write: if true;
    }

    match /impact_stories/{storyId} {
      allow read, write: if true;
    }

    match /faq_items/{faqId} {
      allow read, write: if true;
    }
  }
}
