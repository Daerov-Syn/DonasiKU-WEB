rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === USERS COLLECTION ===
    // Izinkan siapapun membaca data user (untuk pencarian/nama) & izinkan user mengedit datanya sendiri
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // === KATEGORI BARANG (Public Read untuk Mobile & Web) ===
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // === PROGRAM KAMPANYE (Public Read untuk Mobile & Web) ===
    match /programs/{programId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // === MITRA & POSKO PROFILES (Public Read untuk Peta) ===
    match /mitra_profiles/{mitraId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // === BARANG DONASI (Donation Items) ===
    match /donation_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // === DONASI DANA (Donation Money) ===
    match /donation_money/{moneyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // === SERTIFIKAT DONASI ===
    match /certificates/{certId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // === KISAH DAMPAK (Impact Stories) ===
    match /impact_stories/{storyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // === NOTIFIKASI ===
    match /notifications/{notifId} {
      allow read, write: if request.auth != null;
    }

    // === FAQ ===
    match /faq_items/{faqId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
