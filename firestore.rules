rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === USERS COLLECTION ===
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // === KATEGORI BARANG ===
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // === PROGRAM KAMPANYE ===
    match /programs/{programId} {
      allow read, write: if true;
    }

    // === MITRA & POSKO PROFILES ===
    match /mitra_profiles/{mitraId} {
      allow read, write: if true;
    }

    // === BARANG DONASI (Donation Items) ===
    match /donation_items/{itemId} {
      allow read, write: if true;
    }

    // === DONASI DANA (Donation Money) ===
    match /donation_money/{moneyId} {
      allow read, write: if true;
    }

    // === DONASI DANA MOBILE ===
    match /donasiDana/{moneyId} {
      allow read, write: if true;
    }

    // === SERTIFIKAT DONASI ===
    match /certificates/{certId} {
      allow read, write: if true;
    }

    // === KISAH DAMPAK (Impact Stories) ===
    match /impact_stories/{storyId} {
      allow read, write: if true;
    }

    // === NOTIFIKASI ===
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // === FAQ ===
    match /faq_items/{faqId} {
      allow read, write: if true;
    }
  }
}
